# Copy this file to .env on EC2 and fill in unique strong values.
POSTGRES_DB=filenexus
POSTGRES_USER=filenexus_admin
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

AWS_REGION=ap-south-1
S3_QUARANTINE_BUCKET=filenexus-quarantine-143
S3_CLEAN_BUCKET=filenexus-clean-143
SQS_SCAN_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/518040092821/filenexus-scan-queue

# Generate each secret independently using: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_SECRET
SCANNER_TOKEN=CHANGE_ME_DIFFERENT_LONG_RANDOM_SECRET

# Optional: create the first ADMIN account on first startup.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=FileNexusAdmin
BOOTSTRAP_ADMIN_EMAIL=arikaleeswaran@filenexus.com
BOOTSTRAP_ADMIN_PASSWORD=admin@1234567890

SCANNER_TOKEN=YOUR_GENERATED_TOKEN
